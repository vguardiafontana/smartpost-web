[Unit]
Description=SmartPost Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smartpost
Group=smartpost
WorkingDirectory=/opt/smartpost
EnvironmentFile=/etc/smartpost-web.env
ExecStart=/opt/smartpost/.venv/bin/python /opt/smartpost/web_server.py
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
